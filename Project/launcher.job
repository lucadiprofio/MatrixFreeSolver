#!/bin/bash
#PBS -N matrix-free-PDE
#PBS -q cpu
#PBS -l select=1:ncpus=16:mem=32gb
#PBS -l walltime=01:00:00
#PBS -j oe

cd $PBS_O_WORKDIR

echo "Starting job..."
mpirun -np 16 ./matrix-based/build/matrix_based > ./matrix-based/out/results.out
mpirun -np 16 ./matrix-free/build/matrix_free > ./matrix-free/out/results.out
echo "Job finished!"